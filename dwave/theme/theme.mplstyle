# Spines & Lines
axes.linewidth: 1.0
axes.spines.top: False
axes.spines.right: False
lines.linewidth: 2.0
lines.solid_capstyle: round

# Grid
axes.grid: False
axes.axisbelow: True

# Font Stack
font.family: sans-serif
font.sans-serif: Open Sans, Arial, Helvetica, DejaVu Sans, sans-serif
axes.labelsize: 15
axes.labelweight: bold
xtick.labelsize: 12
ytick.labelsize: 12

# Title
axes.titlelocation: left
axes.titlepad: 20
axes.titlesize: 20
axes.titleweight: bold

# Ticks
xtick.major.size: 5
ytick.major.size: 0
xtick.minor.size: 0
ytick.minor.size: 0
xtick.direction: out
ytick.direction: out
xtick.major.pad: 5
ytick.major.pad: 5

# Figure
figure.figsize: 10, 7
figure.dpi: 300

# Saving
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.2

# Legend
legend.frameon: False
legend.loc: best