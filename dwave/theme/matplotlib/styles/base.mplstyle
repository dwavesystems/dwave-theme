# Spines & Lines
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True
lines.linewidth: 2.0
lines.solid_capstyle: round

# Grid
axes.grid: False
axes.axisbelow: True 

# Figure
figure.figsize: 10, 7
figure.dpi: 300
figure.autolayout: True

# Ticks
xtick.major.size: 5
ytick.major.size: 0
xtick.minor.size: 0
ytick.minor.size: 0
xtick.direction: out
ytick.direction: out
xtick.major.pad: 5
ytick.major.pad: 5

# Saving
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.2

# Legend
legend.frameon: False
legend.loc: best
legend.fontsize: 11